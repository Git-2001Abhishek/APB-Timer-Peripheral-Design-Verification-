# SymbiYosys job for apb_timer (properties live in rtl/apb_timer.sv under
# `ifdef FORMAL`).
#   sby -f formal/apb_timer.sby           (all tasks)
#   sby -f formal/apb_timer.sby prove     (unbounded proof, k-induction)

[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 8
cover: mode cover
cover: depth 40

[engines]
smtbmc z3

[script]
read -formal -DFORMAL apb_timer.sv
prep -top apb_timer

[files]
../rtl/apb_timer.sv
